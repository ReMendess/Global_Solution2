# =====================================================================
# Cidade Limpa — variáveis de ambiente de exemplo
# Copie este arquivo para .env e ajuste os valores locais.
# NUNCA versione o arquivo .env real (ele está no .gitignore).
# Este projeto não requer credenciais externas: todos os dados são
# simulados/demonstrativos e identificados como tal.
# =====================================================================

# Ambiente de execução: development | test | production
APP_ENV=development
APP_NAME=Cidade Limpa API
APP_VERSION=0.1.0

# ---------- Backend / banco ----------
# SQLite fica dentro de data/. Use caminho absoluto no .env se necessário.
DATABASE_URL=sqlite:///./data/cidade_limpa.db

# Diretório onde as fotos enviadas pelos cidadãos são gravadas.
UPLOAD_DIR=./data/uploads

# Tamanho máximo aceito por imagem enviada (em megabytes).
MAX_UPLOAD_MB=5

# ---------- Machine Learning ----------
# Caminho dos pesos gerados na FASE 3 (MobileNetV2 + transfer learning).
MODEL_PATH=./ml/models/cidade_limpa_mobilenetv2.keras
MODEL_METADATA_PATH=./ml/models/cidade_limpa_mobilenetv2.metadata.json

# Abaixo deste valor a classificação é marcada como "revisão humana".
CONFIDENCE_THRESHOLD=0.70

# ---------- IoT simulado ----------
# URL que o simulador Python usa para enviar telemetria.
API_BASE_URL=http://127.0.0.1:8000
# Intervalo, em segundos, entre leituras de cada sensor virtual.
SENSOR_INTERVAL_SECONDS=10

# ---------- RPA ----------
# Portal administrativo fictício servido localmente (FASE 5).
RPA_PORTAL_URL=http://127.0.0.1:8100
# Executa o navegador sem interface gráfica.
RPA_HEADLESS=true

# ---------- Servidor ----------
API_HOST=127.0.0.1
API_PORT=8000

# Origens liberadas no CORS (JSON). Em desenvolvimento, "*" atende Expo web/mobile.
# Exemplo restritivo: CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]
CORS_ORIGINS=["*"]
# =====================================================================
# Cidade Limpa — Frontend (Expo)
# Copie para .env.local (ignorado pelo git) apenas se precisar apontar
# para um backend diferente do host do servidor de desenvolvimento.
# =====================================================================

# Sem esta variável, o app usa o host do Metro (Expo) com a porta 8000.
# Exemplos:
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000